        },
        {
            "type": "single",
            "name": "OLED_ENABLE",
            "user_input": "Do you have an OLED?",
            "default": "no"
        },
        {
            "type": "single",
            "name": "ENCODER_ENABLE",
            "user_input": "Do you have one or more rotary encoders?",
            "default": "no"
        },
        {
            "type": "single",
            "name": "PIMORONI_TRACKBALL_ENABLE",
            "user_input": "Do you have a pimoroni trackball?",
